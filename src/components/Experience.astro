---
import { experience } from "@/lib/profile";
import Section from "./Section.astro";
---

<Section id="experiencia" eyebrow="04 — Experiencia" title="Liderazgo & Trayectoria">
  <ol class="relative border-l border-border/80">
    {experience.map((job) => (
      <li class="pb-14 pl-8 last:pb-0 md:pl-10">
        <span
          class={`absolute -left-[5px] mt-2 h-[9px] w-[9px] rounded-full ${
            job.current ? "bg-accent shadow-xs" : "bg-border"
          }`}
        ></span>
        <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
          <div>
            <h3 class="text-xl font-bold tracking-tight text-foreground">
              {job.role}
            </h3>
            <p class="mt-0.5 font-mono text-xs font-semibold text-accent">{job.company}</p>
          </div>
          <p class="font-mono text-xs uppercase tracking-wider text-subtle">
            {job.period}
          </p>
        </div>
        <ul class="mt-6 space-y-3">
          {job.bullets.map((b) => (
            <li class="flex gap-3 text-sm leading-relaxed text-muted">
              <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent/60"></span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Section>
