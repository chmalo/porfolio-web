---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  class?: string;
}

const { id, eyebrow, title, class: className = "" } = Astro.props;
---

<section id={id} class={`scroll-mt-24 py-20 md:py-28 ${className}`}>
  <div class="mx-auto w-full max-w-5xl px-6">
    <div class="mb-12 md:mb-16">
      {eyebrow && (
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent font-semibold">
          {eyebrow}
        </p>
      )}
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl text-foreground font-sans">
        {title}
      </h2>
    </div>
    <slot />
  </div>
</section>
