---
import { profile } from "@/lib/profile";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-6 py-8 text-sm text-subtle md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-3">
      <img
        src="/img/logo-icon.png"
        alt="Logo Christian Fernández"
        class="h-6 w-auto shrink-0 opacity-80"
        width="24"
        height="28"
      />
      <div class="flex flex-col">
        <span class="font-sans font-semibold text-foreground text-xs">
          {profile.name}
        </span>
        <span class="font-mono text-[10px] text-muted uppercase tracking-wider">
          Desarrollador Full-Stack
        </span>
      </div>
    </div>
    <div class="text-xs text-subtle md:text-right">
      <p>
        © {currentYear} {profile.name}
      </p>
    </div>
  </div>
</footer>
