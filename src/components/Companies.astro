---
import { companies } from "@/lib/profile";
import Icon from "./Icon.astro";
---

<section
  id="empresas"
  class="scroll-mt-24 border-y border-border bg-surface/40 py-16 md:py-20"
>
  <div class="mx-auto w-full max-w-5xl px-6">
    <div class="mb-10 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl font-sans">
        Empresas &amp; Clientes Corporativos
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-muted font-sans">
        Experiencia en modernización de sistemas ERP empresariales, optimización de bases de datos y plataformas operativas en producción.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      {companies.map((company) => {
        const isFeatured = company.name === "Pensanómica";
        return (
          <article
            class={`group flex flex-col justify-between rounded-2xl border border-border bg-background p-6 transition-all duration-200 hover:border-accent/50 hover:bg-surface hover:shadow-xs ${
              isFeatured
                ? "lg:col-span-12 border-accent/30 bg-accent-soft/20 dark:bg-surface/80"
                : "lg:col-span-6"
            }`}
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-center gap-4">
                <div
                  class={`flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-border/80 p-2 shadow-xs transition-transform duration-300 group-hover:scale-105 ${
                    company.logoBg ?? "bg-surface"
                  }`}
                >
                  {company.logo ? (
                    <img
                      src={company.logo}
                      alt={`Logo de ${company.name}`}
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain"
                    />
                  ) : (
                    <span class="font-mono text-sm font-bold text-accent">
                      {company.name.slice(0, 2).toUpperCase()}
                    </span>
                  )}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-lg font-bold tracking-tight text-foreground transition-colors group-hover:text-accent font-sans">
                      {company.name}
                    </h3>
                    {isFeatured && (
                      <span class="rounded-full bg-accent/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-accent">
                        Caso Insignia
                      </span>
                    )}
                  </div>
                  <p class="font-mono text-xs text-accent font-medium mt-0.5">
                    {company.role}
                  </p>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <span class="font-mono text-xs text-subtle hidden sm:inline-block">
                  {company.period}
                </span>
                {company.linkedinUrl && (
                  <a
                    href={company.linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-subtle transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                    title={`LinkedIn de ${company.name}`}
                    aria-label={`Ver perfil de LinkedIn de ${company.name}`}
                  >
                    <Icon name="linkedin" class="h-4 w-4" />
                  </a>
                )}
                {company.url && (
                  <a
                    href={company.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-subtle transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                    title={`Sitio web de ${company.name}`}
                    aria-label={`Visitar sitio web de ${company.name}`}
                  >
                    <Icon name="arrow-up-right" class="h-4 w-4" />
                  </a>
                )}
              </div>
            </div>

            <div class="mt-5">
              <p class="text-sm leading-relaxed text-muted font-sans">
                {company.description}
              </p>
              {isFeatured && (
                <div class="mt-4 flex flex-wrap gap-2 pt-3 border-t border-border/60 font-mono text-xs text-subtle">
                  <span class="rounded bg-surface border border-border px-2.5 py-1 text-foreground">
                    MySQL Query Optimization
                  </span>
                  <span class="rounded bg-surface border border-border px-2.5 py-1 text-foreground">
                    Flexio ERP (Panamá)
                  </span>
                  <span class="rounded bg-surface border border-border px-2.5 py-1 text-foreground">
                    Vue a React 18 (0% Downtime)
                  </span>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
