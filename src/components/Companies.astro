---
import { companies } from "@/lib/profile";
import Icon from "./Icon.astro";
---

<section
  id="empresas"
  class="scroll-mt-24 border-y border-border bg-surface/40 py-16 md:py-20"
>
  <div class="mx-auto w-full max-w-5xl px-6">
    <div class="mb-10 flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent font-semibold">
          Confianza &amp; Trayectoria
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground md:text-3xl font-mono">
          Empresas con las que he trabajado
        </h2>
      </div>
      <p class="text-xs font-mono leading-relaxed text-muted md:max-w-xs md:text-right">
        Experiencia en sistemas de gestión ERP, optimización de bases de datos y plataformas web.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
      {companies.map((company) => {
        const cardClasses =
          "group flex flex-col justify-between rounded-2xl border border-border bg-background p-6 transition-all duration-200 hover:border-accent/50 hover:bg-surface hover:shadow-xs";

        const content = (
          <>
            <div class="flex items-start justify-between gap-4">
              <div
                class={`flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-border/80 p-2 shadow-xs transition-transform duration-300 group-hover:scale-105 ${
                  company.logoBg ?? "bg-surface"
                }`}
              >
                {company.logo ? (
                  <img
                    src={company.logo}
                    alt={`Logo de ${company.name}`}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain"
                  />
                ) : (
                  <span class="font-mono text-sm font-bold text-accent">
                    {company.name.slice(0, 2).toUpperCase()}
                  </span>
                )}
              </div>
              {company.url && (
                <Icon name="arrow-up-right" class="shrink-0 text-subtle transition-colors group-hover:text-accent" />
              )}
            </div>

            <div class="mt-6 flex flex-1 flex-col justify-between">
              <div>
                <div class="flex items-baseline justify-between gap-2">
                  <h3 class="text-lg font-bold tracking-tight text-foreground transition-colors group-hover:text-accent">
                    {company.name}
                  </h3>
                  <span class="font-mono text-xs text-subtle">
                    {company.period}
                  </span>
                </div>
                <p class="mt-1 font-mono text-xs text-accent font-medium">
                  {company.role}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-muted font-sans">
                  {company.description}
                </p>
              </div>
            </div>
          </>
        );

        return company.url ? (
          <a
            href={company.url}
            target="_blank"
            rel="noopener noreferrer"
            class={cardClasses}
          >
            {content}
          </a>
        ) : (
          <article class={cardClasses}>
            {content}
          </article>
        );
      })}
    </div>
  </div>
</section>
