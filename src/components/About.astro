---
import { profile, softSkills } from "@/lib/profile";
import Icon from "./Icon.astro";
import Section from "./Section.astro";
---

<Section id="sobre-mi" eyebrow="01 — Sobre mí" title="Trayectoria & Enfoque">
  <div class="grid gap-10 md:grid-cols-5">
    <div class="space-y-4 md:col-span-3 text-base leading-relaxed text-muted">
      <p>
        {profile.summary}
      </p>
      <div class="rounded-xl border border-border/80 bg-surface/40 p-5">
        <p class="font-mono text-[11px] uppercase tracking-wider text-accent font-semibold mb-2">Filosofía de Trabajo</p>
        <p class="text-sm leading-relaxed text-foreground/90 font-sans">
          "{profile.philosophy}"
        </p>
      </div>
      <p class="text-sm text-subtle font-mono">
        Ubicación: <span class="text-foreground">{profile.location}</span> · Modalidad: <span class="text-foreground">Remoto / Híbrido</span>
      </p>
    </div>

    <div class="md:col-span-2 flex flex-col gap-5">
      <div class="overflow-hidden rounded-2xl border border-border bg-surface/50 shadow-xs aspect-square max-w-[200px] sm:max-w-[220px]">
        <img
          src="/img/christian-fernandez.jpg"
          alt="Christian Fernández — Desarrollador Full-Stack"
          class="h-full w-full object-cover object-top"
          width="440"
          height="440"
          loading="lazy"
        />
      </div>

      <div class="rounded-xl border border-border bg-surface/50 p-5 divide-y divide-border/60">
        {profile.highlights.map((h) => (
          <div class="py-3 first:pt-0 last:pb-0 flex items-baseline justify-between gap-4 font-mono">
            <span class="text-xl font-bold text-accent">
              {h.value}
            </span>
            <span class="text-xs text-muted text-right font-sans">{h.label}</span>
          </div>
        ))}
      </div>

      <div class="mt-4 rounded-xl border border-border bg-surface/50 p-5">
        <span class="font-mono text-[11px] text-accent uppercase tracking-wider block font-semibold">Prueba Social</span>
        <p class="text-xs font-semibold text-foreground mt-1">Recomendaciones verificadas</p>
        <p class="text-[11px] text-muted mt-1 leading-relaxed">Avales reales de directores y compañeros de equipo sobre calidad técnica, resolución de problemas y entregas en producción.</p>
        <a
          href={profile.social.linkedinRecommendations}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1.5 font-mono text-xs text-accent hover:underline"
        >
          <span>Ver recomendaciones en LinkedIn</span>
          <Icon name="arrow-up-right" />
        </a>
      </div>
    </div>
  </div>

  <div class="mt-12">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-subtle">Competencias Técnicas &amp; Dominios de Negocio</p>
    <ul class="flex flex-wrap gap-2">
      {softSkills.map((s) => (
        <li class="rounded border border-border bg-surface px-3 py-1 font-mono text-xs text-muted">
          {s}
        </li>
      ))}
    </ul>
  </div>
</Section>
