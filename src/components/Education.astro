---
import { certifications, education, languages } from "@/lib/profile";
import Section from "./Section.astro";
---

<Section id="formacion" eyebrow="05 — Formación" title="Educación & Certificaciones">
  <div class="grid gap-10 md:grid-cols-5">
    <div class="space-y-10 md:col-span-2">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">Educación Universitaria</p>
        <h3 class="text-xl font-bold tracking-tight text-foreground">
          {education.degree}
        </h3>
        <p class="mt-1 text-sm text-muted">{education.institution}</p>
        <span class="mt-3 inline-block rounded border border-accent/30 bg-accent/10 px-2.5 py-1 font-mono text-xs font-semibold text-accent">
          {education.status}
        </span>
      </div>

      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">Idiomas</p>
        <ul class="space-y-2.5">
          {languages.map((l) => (
            <li class="flex justify-between gap-4 font-mono text-xs">
              <span class="text-foreground">{l.name}</span>
              <span class="text-muted">{l.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="md:col-span-3">
      <p class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">Certificaciones &amp; Excelencia</p>
      <ul class="divide-y divide-border border-y border-border">
        {certifications.map((c) => (
          <li class="flex items-baseline justify-between gap-6 py-4">
            <div>
              <p class="text-sm font-medium text-foreground">{c.title}</p>
              <p class="mt-0.5 font-mono text-xs text-subtle">{c.issuer}</p>
            </div>
            <span class="font-mono text-xs text-accent shrink-0">{c.year}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
