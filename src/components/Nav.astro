---
import { navLinks, profile } from "@/lib/profile";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  id="main-nav-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors"
>
  <nav class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-6">
    <a
      href="/"
      class="group flex items-center gap-3 transition-opacity hover:opacity-90"
      aria-label={`${profile.name} — Inicio`}
    >
      <img
        src="/img/logo-icon.png"
        alt="Logo Christian Fernández"
        class="h-8 w-auto shrink-0 transition-transform duration-300 group-hover:scale-105"
        width="32"
        height="37"
      />
      <div class="flex flex-col">
        <span class="font-sans text-sm font-bold tracking-tight text-foreground leading-snug">
          {profile.name}
        </span>
        <span class="font-mono text-[10px] uppercase tracking-wider text-accent font-semibold leading-none">
          Full-Stack Engineer
        </span>
      </div>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link={link.href}
            class="text-sm font-medium text-muted transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <button
        id="mobile-nav-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
      >
        <svg
          id="menu-open-icon"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          id="menu-close-icon"
          class="hidden h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </nav>

  <ul
    id="mobile-nav-menu"
    class="hidden border-t border-border px-6 py-4 md:hidden bg-background/95 backdrop-blur-md"
  >
    {navLinks.map((link) => (
      <li>
        <a
          href={link.href}
          data-mobile-nav-link
          class="block py-3 text-base text-muted transition-colors hover:text-foreground"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</header>

<script>
  function initNav() {
    const header = document.getElementById("main-nav-header");
    const toggleBtn = document.getElementById("mobile-nav-toggle");
    const menu = document.getElementById("mobile-nav-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");
    const links = document.querySelectorAll("[data-mobile-nav-link]");
    const navAnchors = document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]");

    if (!header || !toggleBtn || !menu) return;

    let isOpen = false;

    const updateHeaderStyle = () => {
      const isScrolled = window.scrollY > 8;
      if (isScrolled || isOpen) {
        header.classList.add("border-border", "bg-background/80", "backdrop-blur-md");
        header.classList.remove("border-transparent");
      } else {
        header.classList.remove("border-border", "bg-background/80", "backdrop-blur-md");
        header.classList.add("border-transparent");
      }
    };

    const toggleMenu = (forceState?: boolean) => {
      isOpen = typeof forceState === "boolean" ? forceState : !isOpen;
      menu.classList.toggle("hidden", !isOpen);
      if (openIcon && closeIcon) {
        openIcon.classList.toggle("hidden", isOpen);
        closeIcon.classList.toggle("hidden", !isOpen);
      }
      toggleBtn.setAttribute("aria-expanded", isOpen.toString());
      toggleBtn.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
      updateHeaderStyle();
    };

    toggleBtn.addEventListener("click", () => toggleMenu());
    links.forEach((l) => l.addEventListener("click", () => toggleMenu(false)));
    window.addEventListener("scroll", updateHeaderStyle, { passive: true });
    updateHeaderStyle();

    const sections = Array.from(navAnchors)
      .map((a) => {
        const id = a.getAttribute("data-nav-link")?.replace("#", "");
        return id ? document.getElementById(id) : null;
      })
      .filter((sec): sec is HTMLElement => Boolean(sec));

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute("id");
              navAnchors.forEach((anchor) => {
                const href = anchor.getAttribute("data-nav-link");
                if (href === `#${id}`) {
                  anchor.classList.add("text-accent", "font-semibold");
                  anchor.classList.remove("text-muted");
                } else {
                  anchor.classList.remove("text-accent", "font-semibold");
                  anchor.classList.add("text-muted");
                }
              });
            }
          });
        },
        {
          rootMargin: "-20% 0px -70% 0px",
          threshold: 0,
        }
      );

      sections.forEach((sec) => observer.observe(sec));
    }
  }

  initNav();
  document.addEventListener("astro:after-swap", initNav);
  document.addEventListener("astro:page-load", initNav);
</script>
