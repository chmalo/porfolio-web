---
import { navLinks, profile } from "@/lib/profile";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  id="main-nav-header"
  class="fixed inset-x-0 top-3 z-50 flex justify-center px-4 pointer-events-none"
>
  <div class="pointer-events-auto flex w-full max-w-4xl flex-col items-center">
    <nav
      class="flex w-full items-center justify-between gap-3 rounded-full border border-border/80 bg-background/85 px-4 py-2 shadow-sm backdrop-blur-md transition-all duration-300 sm:px-5"
    >
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="group flex items-center gap-2.5 transition-opacity hover:opacity-90"
          aria-label={`${profile.name} - Inicio`}
        >
          <img
            src="/img/logo-icon.png"
            alt="Logo Christian Fernández"
            class="h-7 w-auto shrink-0 transition-transform duration-300 group-hover:scale-105"
            width="28"
            height="32"
          />
          <span class="font-sans text-sm font-bold tracking-tight text-foreground">
            {profile.name}
          </span>
        </a>

        <div
          class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[11px] font-medium text-emerald-600 dark:text-emerald-400"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Disponible</span>
        </div>
      </div>

      <ul class="hidden items-center gap-1 md:flex">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link={link.href}
              class="rounded-full px-3.5 py-1.5 text-xs font-mono font-medium text-muted transition-colors hover:text-foreground hover:bg-surface"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <ThemeToggle />
        <button
          id="mobile-nav-toggle"
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent md:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
        >
          <svg
            id="menu-open-icon"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            id="menu-close-icon"
            class="hidden h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </nav>

    <ul
      id="mobile-nav-menu"
      class="hidden mt-2 w-full rounded-2xl border border-border bg-background/95 p-4 shadow-lg backdrop-blur-md md:hidden"
    >
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-mobile-nav-link
            class="block rounded-lg px-3 py-2.5 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-foreground"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2 border-t border-border/80 pt-2">
        <div class="flex items-center gap-2 px-3 py-1 font-mono text-xs text-emerald-600 dark:text-emerald-400">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Disponible para contratación</span>
        </div>
      </li>
    </ul>
  </div>
</header>

<script>
  function initNav() {
    const toggleBtn = document.getElementById("mobile-nav-toggle");
    const menu = document.getElementById("mobile-nav-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");
    const links = document.querySelectorAll("[data-mobile-nav-link]");
    const navAnchors = document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]");

    if (!toggleBtn || !menu) return;

    let isOpen = false;

    const toggleMenu = (forceState?: boolean) => {
      isOpen = typeof forceState === "boolean" ? forceState : !isOpen;
      menu.classList.toggle("hidden", !isOpen);
      if (openIcon && closeIcon) {
        openIcon.classList.toggle("hidden", isOpen);
        closeIcon.classList.toggle("hidden", !isOpen);
      }
      toggleBtn.setAttribute("aria-expanded", isOpen.toString());
      toggleBtn.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    };

    toggleBtn.addEventListener("click", () => toggleMenu());
    links.forEach((l) => l.addEventListener("click", () => toggleMenu(false)));

    const sections = Array.from(navAnchors)
      .map((a) => {
        const id = a.getAttribute("data-nav-link")?.replace("#", "");
        return id ? document.getElementById(id) : null;
      })
      .filter((sec): sec is HTMLElement => Boolean(sec));

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute("id");
              navAnchors.forEach((anchor) => {
                const href = anchor.getAttribute("data-nav-link");
                if (href === `#${id}`) {
                  anchor.classList.add("text-accent", "font-semibold", "bg-surface");
                  anchor.classList.remove("text-muted");
                } else {
                  anchor.classList.remove("text-accent", "font-semibold", "bg-surface");
                  anchor.classList.add("text-muted");
                }
              });
            }
          });
        },
        {
          rootMargin: "-20% 0px -70% 0px",
          threshold: 0,
        }
      );

      sections.forEach((sec) => observer.observe(sec));
    }
  }

  initNav();
  document.addEventListener("astro:after-swap", initNav);
  document.addEventListener("astro:page-load", initNav);
</script>
