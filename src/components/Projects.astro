---
import { projects } from "@/lib/profile";
import Icon from "./Icon.astro";
import Section from "./Section.astro";
---

<Section
  id="proyectos"
  title="Casos de Estudio & Arquitectura"
>
  <div class="mb-10 max-w-2xl">
    <p class="text-sm leading-relaxed text-muted font-sans">
      Sistemas empresariales y plataformas en producción. Selecciona o posa el cursor sobre cada caso para inspeccionar su arquitectura y retos de ingeniería.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-5 flex flex-col gap-3">
      {projects.map((p, index) => (
        <button
          type="button"
          data-dossier-trigger={index}
          class={`group w-full text-left rounded-2xl border p-5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent cursor-pointer ${
            index === 0
              ? "border-accent bg-surface shadow-xs text-foreground ring-1 ring-accent/30"
              : "border-border bg-surface/40 hover:border-border hover:bg-surface text-muted"
          }`}
          aria-selected={index === 0 ? "true" : "false"}
          role="tab"
        >
          <div class="flex items-center justify-between gap-3">
            <span class="font-mono text-xs font-bold text-accent">
              0{index + 1}
            </span>
            <span
              class={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 font-mono text-[10px] font-medium ${
                p.status === "Producción" || p.status === "Completado"
                  ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                  : "bg-amber-500/10 text-amber-600 dark:text-amber-400"
              }`}
            >
              <span
                class={`h-1.5 w-1.5 rounded-full ${
                  p.status === "Producción" || p.status === "Completado"
                    ? "bg-emerald-500"
                    : "bg-amber-500"
                }`}
              ></span>
              {p.status}
            </span>
          </div>

          <h3 class="mt-3 text-lg font-bold tracking-tight text-foreground transition-colors group-hover:text-accent font-sans">
            {p.title}
          </h3>

          <p class="mt-1 text-xs text-muted font-sans line-clamp-2 leading-relaxed">
            {p.tagline}
          </p>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-border/60">
            <div class="flex flex-wrap gap-1.5">
              {p.tags.slice(0, 3).map((t) => (
                <span class="rounded bg-accent-soft px-2 py-0.5 font-mono text-[10px] text-accent">
                  {t}
                </span>
              ))}
            </div>
            <span class="font-mono text-xs text-accent transition-transform duration-200 group-hover:translate-x-1">
              →
            </span>
          </div>
        </button>
      ))}
    </div>

    <div class="lg:col-span-7">
      {projects.map((p, index) => (
        <article
          data-dossier-panel={index}
          class={`rounded-2xl border border-border bg-surface p-6 shadow-xs transition-all duration-300 ${
            index === 0 ? "block" : "hidden"
          }`}
          role="tabpanel"
        >
          {p.image && (
            <a
              href={`/proyectos/${p.slug}`}
              class="group/img block aspect-video w-full overflow-hidden rounded-xl border border-border/80 bg-background relative focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              tabindex={index === 0 ? "0" : "-1"}
            >
              <img
                src={p.image}
                alt={`Captura del sistema ${p.title}`}
                class="h-full w-full object-cover object-top transition-transform duration-500 group-hover/img:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background/70 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover/img:opacity-100 flex items-end p-4">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-surface/90 px-3 py-1 font-mono text-xs text-foreground backdrop-blur-xs">
                  <span>Examinar arquitectura</span>
                  <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                </span>
              </div>
            </a>
          )}

          <div class="mt-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span
                  class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-xs font-medium ${
                    p.status === "Producción" || p.status === "Completado"
                      ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                      : "bg-amber-500/10 text-amber-600 dark:text-amber-400"
                  }`}
                >
                  {p.status}
                </span>
                {p.isInternal && (
                  <span class="inline-flex items-center rounded-full border border-border bg-background px-2.5 py-0.5 font-mono text-[11px] text-subtle">
                    Sistema Interno (On-Premise)
                  </span>
                )}
              </div>

              <div class="flex items-center gap-2">
                {p.githubUrl && (
                  <a
                    href={p.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                    title={`Ver repositorio de ${p.title} en GitHub`}
                    aria-label={`Ver repositorio de ${p.title} en GitHub`}
                  >
                    <Icon name="github" class="h-4 w-4" />
                  </a>
                )}
                {p.liveUrl && (
                  <a
                    href={p.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                    title={`Ver ${p.title} en vivo`}
                    aria-label={`Ver ${p.title} en vivo`}
                  >
                    <Icon name="arrow-up-right" class="h-4 w-4" />
                  </a>
                )}
              </div>
            </div>

            <h3 class="mt-4 text-2xl font-bold font-sans tracking-tight text-foreground">
              <a
                href={`/proyectos/${p.slug}`}
                class="transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:rounded"
              >
                {p.title}
              </a>
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-muted font-sans">
              {p.description}
            </p>

            <div class="mt-5 rounded-xl border border-border/80 bg-background/60 p-4">
              <span class="block font-mono text-xs font-semibold text-accent mb-1">
                Límites de Arquitectura &amp; Patrón
              </span>
              <p class="text-xs leading-relaxed text-foreground/90 font-sans">
                {p.architecture.summary}
              </p>
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-border/80">
              <ul class="flex flex-wrap gap-1.5">
                {p.tags.slice(0, 4).map((t) => (
                  <li class="rounded-md border border-border bg-background px-2.5 py-1 font-mono text-xs text-muted">
                    {t}
                  </li>
                ))}
              </ul>

              <a
                href={`/proyectos/${p.slug}`}
                class="inline-flex h-11 items-center gap-2 rounded-full bg-accent px-5 font-mono text-xs font-bold uppercase text-white dark:text-neutral-950 transition-colors hover:bg-accent-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span>Ver Caso Completo</span>
                <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Section>

<script>
  function initDossier() {
    const triggers = document.querySelectorAll<HTMLButtonElement>("[data-dossier-trigger]");
    const panels = document.querySelectorAll<HTMLElement>("[data-dossier-panel]");

    if (triggers.length === 0 || panels.length === 0) return;

    const setActive = (targetIndex: number) => {
      triggers.forEach((trigger, idx) => {
        const isCurrent = idx === targetIndex;
        trigger.setAttribute("aria-selected", isCurrent.toString());

        if (isCurrent) {
          trigger.classList.add("border-accent", "bg-surface", "shadow-xs", "text-foreground", "ring-1", "ring-accent/30");
          trigger.classList.remove("border-border", "bg-surface/40", "text-muted");
        } else {
          trigger.classList.remove("border-accent", "bg-surface", "shadow-xs", "text-foreground", "ring-1", "ring-accent/30");
          trigger.classList.add("border-border", "bg-surface/40", "text-muted");
        }
      });

      panels.forEach((panel, idx) => {
        const isCurrent = idx === targetIndex;
        panel.classList.toggle("hidden", !isCurrent);
        panel.classList.toggle("block", isCurrent);

        const imgLink = panel.querySelector<HTMLAnchorElement>("a[tabindex]");
        if (imgLink) {
          imgLink.tabIndex = isCurrent ? 0 : -1;
        }
      });
    };

    triggers.forEach((trigger) => {
      const idx = Number(trigger.getAttribute("data-dossier-trigger"));
      if (isNaN(idx)) return;

      trigger.addEventListener("click", () => setActive(idx));
      trigger.addEventListener("mouseenter", () => setActive(idx));
    });
  }

  initDossier();
  document.addEventListener("astro:after-swap", initDossier);
  document.addEventListener("astro:page-load", initDossier);
</script>
