---
import { projects } from "@/lib/profile";
import Icon from "./Icon.astro";
import Section from "./Section.astro";
---

<Section
  id="proyectos"
  eyebrow="02 — Proyectos & Arquitectura"
  title="Trabajos Destacados & Arquitectura"
>
  <p class="mb-10 max-w-2xl text-[15px] leading-relaxed text-muted">
    Sistemas en producción y proyectos de ingeniería modelados con Domain-Driven Design (DDD), Arquitectura Hexagonal y separación estricta de responsabilidades.
  </p>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((p) => (
      <article
        class="group relative flex flex-col justify-between rounded-2xl border border-border bg-background p-7 transition-all duration-300 hover:border-accent/40 hover:bg-surface hover:shadow-xs"
      >
        <div>
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span
                class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[11px] font-medium ${
                  p.status === "Producción" || p.status === "Completado"
                    ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                    : "bg-amber-500/10 text-amber-600 dark:text-amber-400"
                }`}
              >
                <span
                  class={`h-1.5 w-1.5 rounded-full ${
                    p.status === "Producción" || p.status === "Completado"
                      ? "bg-emerald-500"
                      : "bg-amber-500 animate-pulse"
                  }`}
                ></span>
                {p.status}
              </span>

              {p.isInternal && (
                <span class="inline-flex items-center rounded-full border border-border bg-surface px-2 py-0.5 font-mono text-[10px] text-subtle">
                  Sistema Interno
                </span>
              )}
            </div>

            <div class="flex items-center gap-2">
              {p.githubUrl && (
                <a
                  href={p.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent"
                  title="Ver repositorio en GitHub"
                  aria-label={`Ver repositorio de ${p.title} en GitHub`}
                >
                  <Icon name="github" />
                </a>
              )}
              {p.liveUrl && (
                <a
                  href={p.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent"
                  title="Ver en vivo"
                  aria-label={`Ver ${p.title} en vivo`}
                >
                  <Icon name="arrow-up-right" />
                </a>
              )}
            </div>
          </div>

          {p.image && (
            <a
              href={`/proyectos/${p.slug}`}
              class="mt-4 block overflow-hidden rounded-xl border border-border/80 bg-surface/50 aspect-video relative focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              tabindex="-1"
              aria-hidden="true"
            >
              <img
                src={p.image}
                alt={`Vista previa de ${p.title}`}
                class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </a>
          )}

          <h3 class="mt-5 text-xl font-bold font-mono tracking-tight text-foreground transition-colors group-hover:text-accent">
            <a
              href={`/proyectos/${p.slug}`}
              class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:rounded"
            >
              {p.title}
            </a>
          </h3>

          <p class="mt-1 font-mono text-xs text-accent font-medium">
            {p.tagline}
          </p>

          <p class="mt-3 text-sm leading-relaxed text-muted font-sans line-clamp-3">
            {p.description}
          </p>

          <div class="mt-4 rounded-xl border border-border/80 bg-surface/60 p-4">
            <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-accent font-semibold mb-1.5">
              <Icon name="layers" class="h-3.5 w-3.5 shrink-0" />
              <span>Arquitectura &amp; Patrón</span>
            </div>
            <p class="text-xs leading-relaxed text-muted font-sans line-clamp-3">
              {p.architecture.summary}
            </p>
          </div>

          <ul class="mt-6 flex flex-wrap gap-1.5">
            {p.tags.slice(0, 5).map((t) => (
              <li
                class="rounded-md bg-accent-soft px-2 py-0.5 font-mono text-[11px] text-accent"
              >
                {t}
              </li>
            ))}
            {p.tags.length > 5 && (
              <li class="rounded-md border border-border px-1.5 py-0.5 font-mono text-[11px] text-subtle">
                +{p.tags.length - 5}
              </li>
            )}
          </ul>
        </div>

        <div class="mt-8 border-t border-border pt-4">
          <a
            href={`/proyectos/${p.slug}`}
            class="inline-flex w-full items-center justify-between text-xs font-mono font-medium text-foreground transition-colors hover:text-accent"
          >
            <span>Ver caso de estudio &amp; diagrama</span>
            <Icon name="arrow-up-right" class="shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </article>
    ))}
  </div>
</Section>
