import Skills from "@/components/Skills.astro";
import Education from "@/components/Education.astro";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
---

<Layout>
  <Nav />
  <main class="flex-1">
    <Hero />
    <Companies />
    <About />
    <Architecture />
    <Projects />
    <Experience />
    <Skills />
    <Education />
    <Contact />
  </main>
  <Footer />
</Layout>
